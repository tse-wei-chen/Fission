      "requests": 32,
      "concurrency": [8, 16, 32],
      "max_tokens": 256,
      "warmup": 4,
      "timeout_seconds": 300
    },
    {
      "name": "gpu-long-context",
      "endpoint": "completions",
      "prompt_file": "prompts/long-context.txt",
      "requests": 16,
      "concurrency": [1, 4, 8, 16],
      "max_tokens": 64,
      "warmup": 2,
      "timeout_seconds": 300
    }
  ]
}
