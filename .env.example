# Container image/build
DOTNET_VERSION=10.0
FISSION_IMAGE=fission:dev
FISSION_PORT=8000

# Portable/default server composition.
# Keep deterministic defaults for self-contained local/CI serving.
FISSION_BACKEND=deterministic
FISSION_EXECUTION_PROVIDER=cpu
FISSION_DEVICE=cpu:0
FISSION_TOKENIZER=deterministic

# Model mount and real-model metadata.
# The model directory is mounted read-only at /models and is excluded from the
# Docker build context.
FISSION_MODEL_DIR=./models
FISSION_MODEL_FILE=decoder_with_past_model.onnx
FISSION_TOKENIZER_FILE=tokenizer.json
FISSION_MODEL_ID=model
FISSION_NUM_HIDDEN_LAYERS=
FISSION_NUM_KV_HEADS=
FISSION_HEAD_DIM=
FISSION_VOCABULARY_SIZE=
FISSION_EOS_TOKEN_IDS=
FISSION_CHAT_TEMPLATE=none
FISSION_ADD_PROMPT_SPECIAL_TOKENS=true
FISSION_SKIP_SPECIAL_TOKENS_ON_DECODE=true

# KV and scheduler defaults mirror Fission.Server/Program.cs
FISSION_KV_PAGES=16384
FISSION_TOKENS_PER_KV_PAGE=16
FISSION_MAX_BATCH_TOKENS=2048
FISSION_MAX_BATCH_SEQUENCES=128
FISSION_MAX_PREFILL_CHUNK_TOKENS=512
FISSION_ADMISSION_CAPACITY=1024

# NVIDIA CUDA profile (docker compose --profile cuda up server-cuda).
# Microsoft.ML.OnnxRuntime.Gpu 1.30 defaults to CUDA 13.x + cuDNN 9.x.
FISSION_CUDA_IMAGE=fission:cuda-dev
FISSION_CUDA_PORT=8001
FISSION_CUDA_RUNTIME_IMAGE=nvidia/cuda:13.4.2-cudnn-runtime-ubuntu24.04
FISSION_CONTAINER_UID=1654
FISSION_CUDA_DEVICE=cuda:0
FISSION_CUDA_DEVICE_ID=0
FISSION_CUDA_RUNTIME_LIBRARY_PATH=
FISSION_CUDA_PAGE_LOCKED_DECODE_LOGITS=false
FISSION_CUDA_POOL_MAX_RETAINED_BYTES=268435456
FISSION_CUDA_POOL_MAX_RETAINED_BUFFERS_PER_SIZE=8

# Optional graph-side greedy token output added by the ONNX graph rewrite path.
# Example: sampled_token_ids
FISSION_SAMPLED_TOKEN_IDS_OUTPUT=

# Optional full-stack startup inference gate before HTTP serving.
FISSION_STARTUP_PROBE_ENABLED=false
FISSION_STARTUP_PROBE_PROMPT=Hello
FISSION_STARTUP_PROBE_MODEL_ID=model
FISSION_STARTUP_PROBE_MAX_TOKENS=1
FISSION_STARTUP_PROBE_TIMEOUT_SECONDS=120

# NVIDIA Container Toolkit visibility.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
